# Copy to .env and fill in. Every setting is documented in app/config.py.
GROQ_API_KEY=

# Protects POST /triage and /remediate. Strongly recommended outside local dev.
TRITON_API_TOKEN=

# false = agent only proposes restarts; a human approves them in the dashboard.
AUTO_REMEDIATE=false
MAX_RESTARTS_PER_WINDOW=2
RESTART_WINDOW_MINUTES=30
PROTECTED_NAMESPACES=kube-system,kube-public,kube-node-lease

POLL_INTERVAL_SECONDS=30
TRIAGE_COOLDOWN_MINUTES=10
# Leave empty to watch all namespaces.
WATCH_NAMESPACE=

DATABASE_URL=sqlite:///./triton.db
GROQ_MODEL=llama-3.3-70b-versatile
